# Required for Phase 2 (Claude Vision photo analysis + storyboard).
# Not required to boot the app or use Phase 1 import/upload — the vision
# endpoint fails cleanly with a clear 503 if this is unset, rather than
# blocking startup.
ANTHROPIC_API_KEY=

# Required for Phase 3 (Higgsfield cinematic video generation).
# Official SDK accepts either a single "KEY_ID:KEY_SECRET" credential,
# or the two separate fields below.
HF_CREDENTIALS=
HF_API_KEY=
HF_API_SECRET=
