# Copy to .env and adjust. All values are optional for local development.
PORT=4000
# Where the SQLite database, uploaded files and backups are stored.
DATA_DIR=./data
# Set to "production" when serving over HTTPS (enables Secure cookies).
NODE_ENV=development
# Session lifetime in hours.
SESSION_TTL_HOURS=72

# --- Phase 3: electronic signatures (NOT YET CONFIGURED) ---
# ESIGN_PROVIDER=dropbox_sign   # or docusign
# ESIGN_API_KEY=
# --- Phase 4: QuickBooks Online (NOT YET CONFIGURED) ---
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=
